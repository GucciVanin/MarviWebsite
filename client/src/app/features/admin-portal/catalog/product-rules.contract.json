{
  "about": "MRV-9.8 AC-5. The product rules as data, read by BOTH sides so they cannot drift: the API test (SingleProductPathTests) runs every case through ProductRules and compares the limits with its constants; the client spec (product-rules.contract.spec.ts) runs every case through validateProduct/parsePrice/parseQuantity and compares the limits with PRODUCT_LIMITS. A text is prefix + text repeated 'repeat' times. 'valid' is the verdict of the server (the authority). Change a rule: change ProductRules, product-rules.ts and this file together.",
  "limits": {
    "skuMin": 3,
    "skuMax": 40,
    "nameMin": 2,
    "nameMax": 200,
    "description": 2000,
    "attributes": 30,
    "attributeKey": 60,
    "attributeValue": 200,
    "stock": 1000000
  },
  "cases": [
    { "label": "no category chosen", "field": "category", "text": "", "valid": false },

    { "label": "sku of 2 characters", "field": "sku", "text": "ab", "valid": false },
    { "label": "sku of 3 characters", "field": "sku", "text": "abc", "valid": true },
    { "label": "sku of 40 characters", "field": "sku", "text": "s", "repeat": 40, "valid": true },
    { "label": "sku of 41 characters", "field": "sku", "text": "s", "repeat": 41, "valid": false },
    { "label": "sku with letters, digits and - _ .", "field": "sku", "text": "AB-12_x.9", "valid": true },
    { "label": "sku with a space", "field": "sku", "text": "AB 12", "valid": false },
    { "label": "sku with a slash", "field": "sku", "text": "AB/12", "valid": false },
    { "label": "sku with an accent", "field": "sku", "text": "AÇÃO-1", "valid": false },
    { "label": "sku blank", "field": "sku", "text": "", "valid": false },

    { "label": "name of 1 character", "field": "name", "text": "a", "valid": false },
    { "label": "name of 2 characters", "field": "name", "text": "ab", "valid": true },
    { "label": "name of 200 characters", "field": "name", "text": "n", "repeat": 200, "valid": true },
    { "label": "name of 201 characters", "field": "name", "text": "n", "repeat": 201, "valid": false },
    { "label": "name with a zero-width space", "field": "name", "text": "Co​la", "valid": false },
    { "label": "name with a soft hyphen", "field": "name", "text": "Co\u00ADla", "valid": false },
    { "label": "name with a bell character", "field": "name", "text": "Co\u0007la", "valid": false },
    { "label": "name with accents", "field": "name", "text": "Água de côco", "valid": true },
    { "label": "name blank", "field": "name", "text": "", "valid": false },

    { "label": "description of 2000 characters", "field": "description", "text": "d", "repeat": 2000, "valid": true },
    { "label": "description of 2001 characters", "field": "description", "text": "d", "repeat": 2001, "valid": false },
    { "label": "description with line breaks and a tab", "field": "description", "text": "linha 1\n\tlinha 2\r\nlinha 3", "valid": true },
    { "label": "description with a zero-width space", "field": "description", "text": "zero​width", "valid": false },
    { "label": "description with a bidi override", "field": "description", "text": "bidi‮evil", "valid": false },
    { "label": "description with a soft hyphen", "field": "description", "text": "soft\u00ADhyphen", "valid": false },
    { "label": "description with a bidi isolate", "field": "description", "text": "iso\u2066late", "valid": false },
    { "label": "description with a line separator", "field": "description", "text": "sep arator", "valid": false },
    { "label": "description blank", "field": "description", "text": "", "valid": true },


    { "label": "30 attributes", "field": "attributeCount", "repeat": 30, "valid": true },
    { "label": "31 attributes", "field": "attributeCount", "repeat": 31, "valid": false },
    { "label": "attribute name of 60 characters", "field": "attributeKey", "text": "k", "repeat": 60, "valid": true },
    { "label": "attribute name of 61 characters", "field": "attributeKey", "text": "k", "repeat": 61, "valid": false },
    { "label": "attribute value of 200 characters", "field": "attributeValue", "text": "v", "repeat": 200, "valid": true },
    { "label": "attribute value of 201 characters", "field": "attributeValue", "text": "v", "repeat": 201, "valid": false },
    { "label": "attribute value with a line break", "field": "attributeValue", "text": "a\nb", "valid": false },
    { "label": "attribute value with a zero-width space", "field": "attributeValue", "text": "a​b", "valid": false },
    { "label": "attribute value with a bidi isolate", "field": "attributeValue", "text": "a\u2066b", "valid": false },
    { "label": "two attribute names that differ only in case", "field": "attributeDuplicate", "text": "marca", "valid": false },

    { "label": "price 12.5", "field": "price", "text": "12.5", "valid": true },
    { "label": "price 12,50", "field": "price", "text": "12,50", "valid": true },
    { "label": "price 0", "field": "price", "text": "0", "valid": false },
    { "label": "price with three decimals", "field": "price", "text": "1.005", "valid": false },
    { "label": "price that is not a number", "field": "price", "text": "abc", "valid": false },
    { "label": "price negative", "field": "price", "text": "-5", "valid": false },
    { "label": "price blank (no price typed)", "field": "price", "text": "", "valid": true },

    { "label": "quantity 0", "field": "quantity", "text": "0", "valid": true },
    { "label": "quantity 1000000", "field": "quantity", "text": "1000000", "valid": true },
    { "label": "quantity 1000001", "field": "quantity", "text": "1000001", "valid": false },
    { "label": "quantity negative", "field": "quantity", "text": "-1", "valid": false },
    { "label": "quantity with a decimal", "field": "quantity", "text": "1.5", "valid": false },
    { "label": "quantity blank (no quantity typed)", "field": "quantity", "text": "", "valid": true }
  ]
}
