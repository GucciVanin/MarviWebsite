FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY src/Marvi.Domain/Marvi.Domain.csproj src/Marvi.Domain/
COPY src/Marvi.Infrastructure/Marvi.Infrastructure.csproj src/Marvi.Infrastructure/
COPY src/Marvi.Shared/Marvi.Shared.csproj src/Marvi.Shared/
COPY src/Marvi.Api/Marvi.Api.csproj src/Marvi.Api/
RUN dotnet restore src/Marvi.Api/Marvi.Api.csproj

COPY src/ src/
RUN dotnet publish src/Marvi.Api/Marvi.Api.csproj -c Release -o /app --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
COPY --from=build /app .
# The Data Protection keys (MRV-9.4: they encrypt the stored CPFs) live in /keys, which compose mounts as a named volume. Created here and
# owned by the app user, because a new named volume copies the ownership of the folder it covers.
RUN mkdir /keys && chown $APP_UID /keys
USER $APP_UID
EXPOSE 8080
ENTRYPOINT ["dotnet", "Marvi.Api.dll"]
