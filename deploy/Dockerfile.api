FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY src/Marvi.Domain/Marvi.Domain.csproj src/Marvi.Domain/
COPY src/Marvi.Infrastructure/Marvi.Infrastructure.csproj src/Marvi.Infrastructure/
COPY src/Marvi.Shared/Marvi.Shared.csproj src/Marvi.Shared/
COPY src/Marvi.Api/Marvi.Api.csproj src/Marvi.Api/
RUN dotnet restore src/Marvi.Api/Marvi.Api.csproj

COPY src/ src/
RUN dotnet publish src/Marvi.Api/Marvi.Api.csproj -c Release -o /app --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
COPY --from=build /app .
EXPOSE 8080
ENTRYPOINT ["dotnet", "Marvi.Api.dll"]
